{
  "github-auto-sync": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/auto_git_sync.py",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/auto_git_sync.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
